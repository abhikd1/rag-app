# ============================================
# MULTI-LLM API KEYS CONFIGURATION
# ============================================
# Copy this file to .env and add your actual API keys
# Get free API keys from the links below

# GROQ (14,400 requests/day - FASTEST)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# GEMINI (1,500 requests/day)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OPENROUTER (50 requests/day per model, 50+ models)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# HUGGING FACE (Rate-limited free)
# Get key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# DEEPINFRA (Free tier)
# Get key: https://deepinfra.com
DEEPINFRA_API_KEY=your_deepinfra_api_key_here

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Get API keys from the URLs above
# 3. Replace "your_*_api_key_here" with actual keys
# 4. Save the file
# 5. Run: python ultimate_server_multi_llm.py
